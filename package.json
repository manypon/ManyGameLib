{
  "name": "manygamelib",
  "version": "1.4.0",
  "description": "Local Game Lib",
  "author": "manypon",
  "license": "MIT",
  "repository": "github:manypon/manygamelib",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "rcedit": "^4.0.1"
  },
  "build": {
    "appId": "com.manygamelib.app",
    "productName": "ManyGameLib",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "ui/**/*",
      "build/**/*",
      "!build/afterPack.js"
    ],
    "win": {
      "target": [
        "dir",
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ManyGameLib",
      "deleteAppDataOnUninstall": false,
      "artifactName": "ManyGameLib-Setup-${version}.exe"
    },
    "afterPack": "build/afterPack.js",
    "publish": [
      {
        "provider": "github",
        "owner": "manypon",
        "repo": "ManyGameLib"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
